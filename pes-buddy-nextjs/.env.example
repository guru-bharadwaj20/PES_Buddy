# ─── Application ──────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here-change-in-production

# ─── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Get this from: MongoDB Atlas → Connect → Drivers → Node.js
# Replace <username>, <password>, <cluster>, and <dbname>
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority&appName=PESBuddy"

# ─── Redis Cache (optional) ────────────────────────────────────────────────────
# Leave blank to disable caching (app runs fine without Redis)
# REDIS_URL=redis://localhost:6379

# ─── Google OAuth (optional) ──────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Socket.IO ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000
